# Source Salesforce Org
SOURCE_SF_LOGIN_URL=https://your-source-org.sandbox.my.salesforce.com
SOURCE_SF_CLIENT_ID=
SOURCE_SF_CLIENT_SECRET=
SOURCE_SF_GRANT_TYPE=client_credentials
SOURCE_SF_USERNAME=
SOURCE_SF_JWT_KEY_FILE=
SOURCE_SF_SESSION_ID=
SOURCE_SF_API_VERSION=v60.0
# Target Salesforce Org
TARGET_SF_LOGIN_URL=https://your-target-org.sandbox.my.salesforce.com
TARGET_SF_CLIENT_ID=
TARGET_SF_CLIENT_SECRET=
TARGET_SF_GRANT_TYPE=client_credentials
TARGET_SF_USERNAME=
TARGET_SF_JWT_KEY_FILE=
# Paste a Salesforce session ID from Setup, or enter it on the Setup screen.
TARGET_SF_SESSION_ID=
TARGET_SF_API_VERSION=v60.0

# Optional: set to 1 if requests fails with ProxyError to 127.0.0.1 (broken HTTP(S)_PROXY in environment).
# SF_ETL_IGNORE_SYSTEM_PROXY=1
